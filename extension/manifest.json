{
  "manifest_version": 3,
  "name": "Dark Pattern Detector",
  "version": "0.1",
  "description": "Detects manipulative UX patterns on websites",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}